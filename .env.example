# Copia este archivo a .env.local y ajusta el valor si tu backend está en otra dirección.
# Si no existe, la aplicación usa http://localhost:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# CAPTCHA (Cloudflare Turnstile): clave PÚBLICA (site key). Si está vacía, no se muestra CAPTCHA.
# Para probar en local sin cuenta, Cloudflare da una que siempre pasa: 1x00000000000000000000AA
# (en el back, CAPTCHA_ENABLED=true y CAPTCHA_SECRET=1x0000000000000000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=